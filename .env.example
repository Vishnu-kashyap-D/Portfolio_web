# Discord Lanyard integration for the "Currently Playing" Spotify widget.
# See README / final task summary for setup instructions.

# Your Discord user ID (must have joined the Lanyard Discord server, or be
# visible to whichever Lanyard instance LANYARD_API_URL points at).
# VITE_LANYARD_ID is read first (matches the name already configured in
# Vercel); DISCORD_USER_ID is a fallback if you'd rather use that name.
VITE_LANYARD_ID=your_discord_user_id
DISCORD_USER_ID=your_discord_user_id

# Optional. Only needed if your Lanyard instance requires authentication
# (the public api.lanyard.rest endpoint does not). Server-only — never
# exposed to the browser. Do NOT prefix with NEXT_PUBLIC_.
LANYARD_API_KEY=your_lanyard_api_key

# Optional. Defaults to https://api.lanyard.rest. Only set this if you're
# running a self-hosted Lanyard instance.
LANYARD_API_URL=https://api.lanyard.rest
